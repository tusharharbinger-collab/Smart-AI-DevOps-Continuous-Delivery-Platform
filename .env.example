# ─────────────────────────────────────────────────────────────────
# Smart AI DevOps & Continuous Delivery Platform — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform
POSTGRES_DB=platform
POSTGRES_DSN=postgresql+asyncpg://platform:platform@localhost:5432/platform

# ── Redis ────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Signing ──────────────────────────────────────────────────────
# 256-bit random secret shared ONLY between verification-engine and
# policy-controller. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
VERDICT_SIGNING_KEY=change-me-generate-with-secrets-token-hex-32

# ── LLM ──────────────────────────────────────────────────────────
# Groq API key — free tier works. See: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# ── Alerting ─────────────────────────────────────────────────────
# Leave blank to disable Slack alerts (alerts will be logged instead)
SLACK_WEBHOOK_URL=

# ── OPA ──────────────────────────────────────────────────────────
OPA_URL=http://localhost:8181

# ── MinIO (object storage) ───────────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
AWS_ENDPOINT_URL=http://localhost:9000

# ── JWT (API Gateway auth) ───────────────────────────────────────
JWT_SECRET_KEY=change-me-in-prod

# ── Log Level ────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Kubernetes ───────────────────────────────────────────────────
# Path to kubeconfig — only needed for pipeline-worker and policy-controller
# KUBECONFIG=~/.kube/config

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
.venv-test/

# Machine-specific corporate TLS-interception CA bundle, generated locally
# by whoever's on a network that intercepts HTTPS — never a source file,
# and irrelevant (often unusable) on any other machine.
shared/netskope-ca.crt
shared/combined-ca-bundle.pem

# Reference PDF pulled in for background reading, not project source.
*.pdf

# Node
node_modules/
frontend/dist/
frontend/playwright-report/
frontend/test-results/
frontend/tsconfig.tsbuildinfo

# Env / secrets
.env
*.env.local

# Docker / build
*.log

# OS
.DS_Store
Thumbs.db

# Claude Code local session data
.claude/*
!.claude/agents/
!.claude/agents/**

# Vendored binaries (large; documented in README how to obtain locally)
bin/*.exe
bin/kind
bin/opa

# Generated by scripts/setup/connect_kind_network.sh on every run — embeds
# this machine's real Kind cluster client-certificate/key, and the server
# address it rewrites is host-specific. Never a source file.
k8s/generated/

# Reference-only scratch: a Stitch-generated mockup (React 19/Tailwind 4,
# different tech stack entirely) mined for its visual design language during
# Phase 1b (see docs/roadmap/01b-autonoma-visual-refresh.md) and not part of
# the shipped product. The extraction is complete; kept locally for anyone
# who wants to re-check the original, but not part of the project's history.
autonoma-devops/
# A duplicate copy of that same mockup that ended up at the repo root
# (index.html/package.json/src/tsconfig.json/vite.config.ts/metadata.json)
# — redundant with autonoma-devops/ above, not the real frontend (that's
# frontend/), excluded for the same reason.
/index.html
/package.json
/metadata.json
/src/
/tsconfig.json
/vite.config.ts
